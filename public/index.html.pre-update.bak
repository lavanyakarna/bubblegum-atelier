<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Bubblegum Atelier</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#FFF8FA;
    --card:#FFFFFF;
    --pink:#FF6FAE;
    --pink-dark:#E85897;
    --pink-soft:#FFD6E8;
    --cream:#FFF4EC;
    --lavender:#EDE7FF;
    --mint:#DDF8EE;
    --text:#2F2A35;
    --text-soft:#7A7280;
    --border:#F0E8EE;
    --shadow: 0 4px 20px rgba(255,111,174,0.08);
    --shadow-lift: 0 10px 28px rgba(255,111,174,0.18);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:'Inter',sans-serif;
    -webkit-font-smoothing:antialiased;
    position:relative;
  }
  body::before{
    content:"";
    position:fixed; inset:0;
    pointer-events:none;
    z-index:0;
    opacity:0.035;
    background-image:
      radial-gradient(circle, #FF6FAE 1.5px, transparent 1.6px),
      radial-gradient(circle, #B98CFF 1.5px, transparent 1.6px);
    background-size: 90px 90px, 130px 130px;
    background-position: 0 0, 45px 60px;
  }
  h1,h2,h3,h4{
    font-family:'Playfair Display', serif;
    font-weight:600;
    margin:0;
    color:var(--text);
  }
  p{margin:0;}
  button{font-family:'Inter',sans-serif;cursor:pointer;}
  ::selection{background:var(--pink-soft);}
  #root{position:relative;z-index:1;min-height:100vh;}

  /* ---------- utility ---------- */
  .fade-up{
    animation: fadeUp 0.6s cubic-bezier(.22,.9,.32,1) both;
  }
  @keyframes fadeUp{
    from{opacity:0; transform:translateY(16px);}
    to{opacity:1; transform:translateY(0);}
  }
  @keyframes slideIn{
    from{opacity:0; transform:translateY(8px) scale(0.98);}
    to{opacity:1; transform:translateY(0) scale(1);}
  }
  @keyframes popIn{
    0%{opacity:0; transform:scale(0.9);}
    100%{opacity:1; transform:scale(1);}
  }
  @keyframes sparkleFloat{
    0%{opacity:0; transform:translateY(4px) scale(0.6) rotate(0deg);}
    30%{opacity:1;}
    100%{opacity:0; transform:translateY(-22px) scale(1.1) rotate(45deg);}
  }
  @keyframes spin{ to{ transform:rotate(360deg);} }
  @keyframes pulseSoft{
    0%,100%{opacity:1;} 50%{opacity:0.45;}
  }
  @keyframes shimmerBg{
    0%{background-position:0% 50%;}
    50%{background-position:100% 50%;}
    100%{background-position:0% 50%;}
  }

  /* ---------- pill button ---------- */
  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:8px;
    border:none; border-radius:999px;
    padding:12px 26px;
    font-size:14.5px; font-weight:600;
    background:var(--pink);
    color:#fff;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    box-shadow: 0 4px 14px rgba(255,111,174,0.28);
  }
  .btn:hover{ transform:translateY(-2px); box-shadow:0 10px 22px rgba(255,111,174,0.34); background:var(--pink-dark);}
  .btn:active{ transform:translateY(0px); }
  .btn:disabled{ opacity:0.55; cursor:not-allowed; transform:none; box-shadow:none;}
  .btn-ghost{
    background:#fff; color:var(--pink-dark); border:1.5px solid var(--pink-soft);
    box-shadow:none;
  }
  .btn-ghost:hover{ background:var(--pink-soft); box-shadow:0 6px 16px rgba(255,111,174,0.16);}
  .btn-sm{ padding:9px 18px; font-size:13px; }

  /* ---------- card ---------- */
  .card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:20px;
    box-shadow:var(--shadow);
  }

  /* ---------- scrollbar ---------- */
  ::-webkit-scrollbar{ width:8px; height:8px;}
  ::-webkit-scrollbar-thumb{ background:var(--pink-soft); border-radius:8px;}
  ::-webkit-scrollbar-track{ background:transparent;}
</style>
</head>
<body>
<div id="root"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.2.0/umd/react.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.2.0/umd/react-dom.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.24.7/babel.min.js"></script>

<script type="text/babel" data-presets="react">
const { useState, useEffect, useRef, useCallback, useMemo } = React;

/* =======================================================================
   API CLIENT - single shared place for base URL + key
======================================================================= */
const API_CONFIG = {
  baseUrl: "https://bubblegum-atelier.onrender.com",
  apiKey: "dev-key-123",
};

// Identity: a signed-in profile (ba_profile) or a guest id (ba_guest_id)
function getProfile() {
  try { return JSON.parse(localStorage.getItem("ba_profile") || "null"); } catch (e) { return null; }
}
function saveProfile(p) { localStorage.setItem("ba_profile", JSON.stringify(p)); }
function clearProfile() { localStorage.removeItem("ba_profile"); }

function getCustomerId() {
  const p = getProfile();
  if (p && p.customer_id) return p.customer_id;
  let id = localStorage.getItem("ba_guest_id");
  if (!id) {
    id = "guest-" + Math.random().toString(36).slice(2) + Date.now().toString(36);
    localStorage.setItem("ba_guest_id", id);
  }
  return id;
}

async function apiRequest(path, { method = "GET", body, isForm = false } = {}) {
  try {
    const headers = { "X-API-Key": API_CONFIG.apiKey, "X-Customer-Id": getCustomerId() };
    if (!isForm) headers["Content-Type"] = "application/json";
    const res = await fetch(API_CONFIG.baseUrl + path, { method, headers, body });

    let data = null;
    try { data = await res.json(); } catch (e) { /* no body */ }

    if (!res.ok) {
      if (res.status === 401) {
        return { ok: false, status: 401, message: "Oops! Access couldn't be verified. Please check your API key." };
      }
      if (res.status === 503) {
        return { ok: false, status: 503, message: (data && data.message) || "This part of the studio is still learning - please check back soon.", data };
      }
      return { ok: false, status: res.status, message: (data && (data.message || data.detail)) || `Something went wrong (${res.status}). Please try again.`, data };
    }
    return { ok: true, status: res.status, data };
  } catch (err) {
    return { ok: false, status: 0, message: "We couldn't reach your boutique. Make sure the server is running, then try again." };
  }
}

function logEvent(type, productId, meta) {
  apiRequest("/events", {
    method: "POST",
    body: JSON.stringify({ type, product_id: productId || null, meta: meta || {} }),
  });
}

const api = {
  chatbot: (message) => apiRequest("/chatbot", { method: "POST", body: JSON.stringify({ message }) }),
  analyzeSentiment: (text) => apiRequest("/analyze-sentiment", { method: "POST", body: JSON.stringify({ text }) }),
  addReview: (productId, text, customer) => apiRequest("/reviews", { method: "POST", body: JSON.stringify({ product_id: productId, text, customer }) }),
  getReviews: (productId) => apiRequest(productId ? `/reviews?product_id=${productId}` : "/reviews", { method: "GET" }),
  classifyProduct: (file) => {
    const fd = new FormData(); fd.append("file", file);
    return apiRequest("/classify-product", { method: "POST", body: fd, isForm: true });
  },
  dashboardStats: () => apiRequest("/dashboard/stats", { method: "GET" }),
  getProducts: (category) => apiRequest(`/products${category ? `?category=${category}` : ""}`, { method: "GET" }),
  cartGet: () => apiRequest("/cart", { method: "GET" }),
  cartAdd: (productId, qty = 1, size = null) => apiRequest("/cart", { method: "POST", body: JSON.stringify(size ? { product_id: productId, qty, size } : { product_id: productId, qty }) }),
  cartUpdate: (productId, qty) => apiRequest(`/cart/${productId}`, { method: "PATCH", body: JSON.stringify({ qty }) }),
  cartRemove: (productId) => apiRequest(`/cart/${productId}`, { method: "DELETE" }),
  checkoutIntent: () => apiRequest("/checkout-intent", { method: "POST" }),
  funnel: () => apiRequest("/funnel", { method: "GET" }),
  identityRegister: (name, secret, role) => apiRequest("/identity/register", { method: "POST", body: JSON.stringify({ name, secret, role }) }),
  identityLogin: (name, secret) => apiRequest("/identity/login", { method: "POST", body: JSON.stringify({ name, secret }) }),
  favGet: () => apiRequest(`/favorites/${getCustomerId()}`, { method: "GET" }),
  favAdd: (productId) => apiRequest("/favorites", { method: "POST", body: JSON.stringify({ customer: getCustomerId(), product_id: productId }) }),
  favRemove: (productId) => apiRequest("/favorites", { method: "DELETE", body: JSON.stringify({ customer: getCustomerId(), product_id: productId }) }),
  stylewallList: (customer) => apiRequest(`/stylewall/posts${customer ? `?customer=${encodeURIComponent(customer)}` : ""}`, { method: "GET" }),
  stylewallCreate: ({ photo, rating, caption, customer, productId }) => {
    const fd = new FormData();
    fd.append("photo", photo);
    fd.append("rating", String(rating));
    fd.append("caption", caption || "");
    fd.append("customer", customer || "");
    if (productId) fd.append("product_id", productId);
    return apiRequest("/stylewall/posts", { method: "POST", body: fd, isForm: true });
  },
  stylewallCheer: (postId, customer) => apiRequest(`/stylewall/posts/${postId}/cheer`, { method: "POST", body: JSON.stringify({ customer }) }),
  stylewallComment: (postId, customer, text) => apiRequest(`/stylewall/posts/${postId}/comments`, { method: "POST", body: JSON.stringify({ customer, text }) }),
};

/* =======================================================================
   ICONS - single thin-outline set, hand drawn, used consistently
======================================================================= */
function Icon({ name, size = 20, strokeWidth = 1.6, className = "", style = {}, fill = "none" }) {
  const common = { width: size, height: size, viewBox: "0 0 24 24", fill, stroke: "currentColor", strokeWidth, strokeLinecap: "round", strokeLinejoin: "round", className, style };
  const paths = {
    home: <><path d="M3.5 10.5L12 3.5l8.5 7" /><path d="M5.5 9.5V19a1 1 0 0 0 1 1H9.5v-5.5a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1V20h3a1 1 0 0 0 1-1V9.5" /></>,
    bag: <><path d="M6.5 8h11l0.9 12.2a1 1 0 0 1-1 1.1H6.6a1 1 0 0 1-1-1.1L6.5 8z" /><path d="M9 8V6.2a3 3 0 0 1 6 0V8" /></>,
    heart: <path d="M12 20.2s-7.6-4.5-9.9-9C0.4 7.7 2 4 5.6 4c2.1 0 3.6 1.3 4.7 3 1-1.7 2.6-3 4.7-3 3.6 0 5.2 3.7 3.5 7.2-2.3 4.5-9 9-9 9z" />,
    search: <><circle cx="11" cy="11" r="6.5" /><path d="M15.8 15.8L21 21" /></>,
    chat: <><path d="M21 11.5a8 8 0 0 1-8 8H6.8L3.5 22l0.6-3.8A8 8 0 1 1 21 11.5z" /></>,
    camera: <><path d="M3.5 8.3a1 1 0 0 1 1-1h2.3l1.4-1.8h7.6l1.4 1.8h2.3a1 1 0 0 1 1 1v9.9a1 1 0 0 1-1 1H4.5a1 1 0 0 1-1-1V8.3z" /><circle cx="12" cy="13.3" r="3.4" /></>,
    sparkle: <><path d="M12 3l1.7 4.9L18.5 9.5l-4.8 1.7L12 16l-1.7-4.8-4.8-1.7 4.8-1.6L12 3z" /><path d="M19 15.5l0.8 2.1 2.1 0.8-2.1 0.8-0.8 2.1-0.8-2.1-2.1-0.8 2.1-0.8 0.8-2.1z" /></>,
    gear: <><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.9 2.9l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6V21a2 2 0 1 1-4 0v-.1A1.7 1.7 0 0 0 8.8 19.4a1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.9-2.9l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.6-1H2.5a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 4.2 8.8a1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.9-2.9l.1.1a1.7 1.7 0 0 0 1.9.3H8.8A1.7 1.7 0 0 0 9.8 2.7V2.5a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.9 2.9l-.1.1a1.7 1.7 0 0 0-.3 1.9v.1a1.7 1.7 0 0 0 1.6 1h.2a2 2 0 1 1 0 4h-.2a1.7 1.7 0 0 0-1.5 1z" /></>,
    cloud: <><path d="M7.5 18a4 4 0 0 1-.5-8 5.2 5.2 0 0 1 10-1.8 3.6 3.6 0 0 1-.6 7.1" /><path d="M12 12v6.5M9.3 15l2.7-2.7 2.7 2.7" /></>,
    image: <><rect x="3.3" y="4.5" width="17.4" height="15" rx="2.2" /><circle cx="8.6" cy="9.6" r="1.4" /><path d="M4 18.3l5.3-5.3a1.3 1.3 0 0 1 1.8 0l3 3M14.5 14.8l1.3-1.3a1.3 1.3 0 0 1 1.8 0l3 3" /></>,
    x: <><path d="M17 7L7 17M7 7l10 10" /></>,
    check: <path d="M4.5 12.3l4.4 4.4L19.5 6" />,
    alert: <><path d="M10.6 4.3a1.7 1.7 0 0 1 2.8 0l8 13.7a1.7 1.7 0 0 1-1.4 2.6H4a1.7 1.7 0 0 1-1.4-2.6l8-13.7z" /><path d="M12 9.7v3.6M12 16.7h.01" /></>,
    refresh: <><path d="M20.5 12a8.5 8.5 0 1 1-2.7-6.2" /><path d="M20.5 3.5v5h-5" /></>,
    user: <><circle cx="12" cy="8.3" r="3.6" /><path d="M4.5 20c0-4 3.6-6.3 7.5-6.3s7.5 2.3 7.5 6.3" /></>,
    send: <path d="M21 3L10.5 13.5M21 3l-6.5 18-4-8-8-4L21 3z" />,
    chevron: <path d="M9 6l6 6-6 6" />,
    menu: <><path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17" /></>,
    flower: <><circle cx="12" cy="12" r="2.1" /><circle cx="12" cy="6.3" r="2.6" /><circle cx="12" cy="17.7" r="2.6" /><circle cx="6.3" cy="12" r="2.6" /><circle cx="17.7" cy="12" r="2.6" /></>,
    hanger: <><path d="M12 3.3a1.8 1.8 0 0 1 1 3.3v1l7.6 4.8a1.6 1.6 0 0 1 .8 1.4v1H2.6v-1a1.6 1.6 0 0 1 .8-1.4L11 7.6v-1a1.8 1.8 0 0 1 1-3.3z" /><path d="M4 17.8h16" /></>,
    lipstick: <><rect x="9.3" y="2.5" width="5.4" height="6" rx="1.6" /><path d="M9.3 8.5h5.4l-1 12a1.7 1.7 0 0 1-3.4 0l-1-12z" /></>,
    photo: <><path d="M4.5 6.5h4l1.5-2h4l1.5 2h4a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1h-15a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1z" /><circle cx="12" cy="13" r="3.4" /></>,
    shoe: <><path d="M3 17.5v-4l3.3-1.3 2-2.7c.5-.6 1.3-1 2.1-1h1.1c.4 0 .8.2 1 .5l1 1.5 5.5 1.6a2 2 0 0 1 1.5 1.9v3.5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z" /><path d="M3 17.5h18" /></>,
    bolt: <path d="M13 2.5L4.5 14h6l-1.5 7.5L18.5 10h-6L13 2.5z" />,
    star: <path d="M12 3.5l2.3 5.1 5.6.6-4.2 3.8 1.2 5.5L12 15.8l-4.9 2.7 1.2-5.5-4.2-3.8 5.6-.6L12 3.5z" />,
  };
  return <svg {...common}>{paths[name] || null}</svg>;
}

/* =======================================================================
   SHARED HOOKS
======================================================================= */
function useCountUp(target, duration = 1100, active = true) {
  const [value, setValue] = useState(0);
  useEffect(() => {
    if (!active) return;
    let raf, start = null;
    const t = Number(target) || 0;
    function step(ts) {
      if (start === null) start = ts;
      const p = Math.min((ts - start) / duration, 1);
      const eased = 1 - Math.pow(1 - p, 3);
      setValue(Math.round(eased * t));
      if (p < 1) raf = requestAnimationFrame(step);
    }
    raf = requestAnimationFrame(step);
    return () => cancelAnimationFrame(raf);
  }, [target, active]);
  return value;
}

/* =======================================================================
   SHARED UI COMPONENTS
======================================================================= */
function LoadingState({ label }) {
  const messages = ["Thinking...", "Scanning...", "Reading the details...", "Styling your view..."];
  const [msg] = useState(label || messages[Math.floor(Math.random() * messages.length)]);
  return (
    <div style={{ display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", padding: "48px 20px", gap: 14 }}>
      <div style={{
        width: 34, height: 34, borderRadius: "50%",
        border: "3px solid var(--pink-soft)", borderTopColor: "var(--pink)",
        animation: "spin 0.85s linear infinite"
      }} />
      <p style={{ color: "var(--text-soft)", fontSize: 14, fontWeight: 500, animation: "pulseSoft 1.6s ease-in-out infinite" }}>{msg}</p>
    </div>
  );
}

function EmptyState({ icon = "flower", title, subtitle }) {
  return (
    <div style={{ textAlign: "center", padding: "40px 24px" }}>
      <div style={{ width: 52, height: 52, borderRadius: "50%", background: "var(--cream)", display: "flex", alignItems: "center", justifyContent: "center", margin: "0 auto 14px", color: "var(--pink)" }}>
        <Icon name={icon} size={24} />
      </div>
      <p style={{ fontWeight: 600, fontSize: 15, marginBottom: 4 }}>{title}</p>
      {subtitle && <p style={{ color: "var(--text-soft)", fontSize: 13.5, maxWidth: 340, margin: "0 auto" }}>{subtitle}</p>}
    </div>
  );
}

function ErrorState({ message, onRetry }) {
  return (
    <div className="card fade-up" style={{ padding: "28px 24px", textAlign: "center", background: "var(--cream)", border: "1px solid var(--pink-soft)" }}>
      <div style={{ width: 46, height: 46, borderRadius: "50%", background: "#fff", display: "flex", alignItems: "center", justifyContent: "center", margin: "0 auto 12px", color: "var(--pink-dark)" }}>
        <Icon name="alert" size={22} />
      </div>
      <p style={{ fontWeight: 700, fontSize: 15, marginBottom: 4 }}>Something needs your attention</p>
      <p style={{ color: "var(--text-soft)", fontSize: 13.5, marginBottom: onRetry ? 16 : 0 }}>{message}</p>
      {onRetry && <button className="btn btn-sm" onClick={onRetry}><Icon name="refresh" size={15} /> Try again</button>}
    </div>
  );
}

function ConfidenceBar({ percent, color = "var(--pink)", trackColor = "var(--pink-soft)" }) {
  const [w, setW] = useState(0);
  useEffect(() => { const t = setTimeout(() => setW(percent), 80); return () => clearTimeout(t); }, [percent]);
  return (
    <div style={{ width: "100%", height: 10, borderRadius: 999, background: trackColor, overflow: "hidden" }}>
      <div style={{ height: "100%", width: `${w}%`, background: color, borderRadius: 999, transition: "width 1s cubic-bezier(.22,.9,.32,1)" }} />
    </div>
  );
}

function StatNumber({ value, active = true }) {
  const n = useCountUp(value, 1200, active);
  return <span>{n}</span>;
}

function Donut({ segments, size = 168 }) {
  const total = segments.reduce((a, s) => a + s.value, 0) || 1;
  const r = size / 2 - 16;
  const c = 2 * Math.PI * r;
  let offsetAcc = 0;
  const [animate, setAnimate] = useState(false);
  useEffect(() => { const t = setTimeout(() => setAnimate(true), 100); return () => clearTimeout(t); }, []);
  return (
    <svg width={size} height={size} viewBox={`0 0 ${size} ${size}`}>
      <circle cx={size/2} cy={size/2} r={r} fill="none" stroke="var(--border)" strokeWidth={18} />
      {segments.map((s, i) => {
        const frac = s.value / total;
        const dash = animate ? frac * c : 0;
        const gap = c - dash;
        const rotate = (offsetAcc / total) * 360 - 90;
        offsetAcc += s.value;
        return (
          <circle key={i} cx={size/2} cy={size/2} r={r} fill="none" stroke={s.color} strokeWidth={18}
            strokeDasharray={`${dash} ${gap}`} strokeLinecap="round"
            transform={`rotate(${rotate} ${size/2} ${size/2})`}
            style={{ transition: "stroke-dasharray 1.1s cubic-bezier(.22,.9,.32,1)" }} />
        );
      })}
    </svg>
  );
}

function Sparkles({ show }) {
  if (!show) return null;
  const pts = [{x:10,y:10},{x:80,y:6},{x:45,y:30},{x:65,y:45},{x:20,y:38}];
  return (
    <div style={{ position: "absolute", inset: 0, pointerEvents: "none" }}>
      {pts.map((p, i) => (
        <div key={i} style={{ position: "absolute", left: `${p.x}%`, top: `${p.y}%`, color: "var(--pink)", animation: `sparkleFloat 0.9s ease-out ${i*0.06}s both` }}>
          <Icon name="sparkle" size={16} />
        </div>
      ))}
    </div>
  );
}

/* =======================================================================
   WELCOME SCREEN
======================================================================= */
function WelcomeScreen({ onEnter }) {
  return (
    <div style={{
      minHeight: "100vh", display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center",
      padding: "40px 20px", position: "relative", overflow: "hidden",
      background: "linear-gradient(160deg, #FFE6F0 0%, #FFF8FA 45%, #FFF4EC 100%)"
    }}>
      <div className="fade-up" style={{ textAlign: "center", maxWidth: 620, position: "relative", zIndex: 2 }}>
        <div style={{ display: "inline-flex", alignItems: "center", gap: 8, background: "#fff", border: "1px solid var(--pink-soft)", padding: "6px 16px", borderRadius: 999, marginBottom: 26, boxShadow: "var(--shadow)" }}>
          <Icon name="sparkle" size={14} style={{ color: "var(--pink)" }} />
          <span style={{ fontSize: 12.5, fontWeight: 600, color: "var(--pink-dark)", letterSpacing: 0.3 }}>AI-Powered Boutique</span>
        </div>
        <img src={API_CONFIG.baseUrl + "/static/graphics/welcome-hero.png"} alt="Bubblegum Atelier boutique" style={{ width: "min(320px, 78%)", borderRadius: 22, margin: "0 auto 26px", display: "block", boxShadow: "var(--shadow)" }} />
        <h1 style={{ fontSize: "clamp(38px, 7vw, 64px)", lineHeight: 1.08, marginBottom: 14, letterSpacing: -0.5 }}>Bubblegum Atelier</h1>
        <p style={{ fontFamily: "'Playfair Display', serif", fontStyle: "italic", fontSize: "clamp(17px, 2.4vw, 21px)", color: "var(--pink-dark)", marginBottom: 16 }}>Where Style Meets Intelligence</p>
        <p style={{ color: "var(--text-soft)", fontSize: 15.5, lineHeight: 1.6, maxWidth: 480, margin: "0 auto 34px" }}>
          Helping your boutique understand customers, products and stories - one gentle insight at a time.
        </p>
        <button className="btn" onClick={onEnter} style={{ padding: "14px 34px", fontSize: 15.5 }}>
          Enter Studio <Icon name="chevron" size={16} />
        </button>
      </div>

      <div className="fade-up" style={{ animationDelay: "0.15s", display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(190px, 1fr))", gap: 16, maxWidth: 760, width: "100%", marginTop: 56, position: "relative", zIndex: 2 }}>
        {[
          { icon: "bag", title: "Smart Storefront", desc: "A shop that remembers every visitor kindly.", bg: "var(--pink-soft)" },
          { icon: "star", title: "Picked For You", desc: "Recommendations with reasons, not guesses.", bg: "var(--mint)" },
          { icon: "sparkle", title: "Boutique Tools", desc: "Catalog tagging, review mood and store stats.", bg: "var(--lavender)" },
        ].map((p, i) => (
          <div key={i} className="card" style={{ padding: "22px 18px", textAlign: "center" }}>
            <div style={{ width: 42, height: 42, borderRadius: "50%", background: p.bg, display: "flex", alignItems: "center", justifyContent: "center", margin: "0 auto 12px", color: "var(--pink-dark)" }}>
              <Icon name={p.icon} size={19} />
            </div>
            <p style={{ fontWeight: 700, fontSize: 14.5, marginBottom: 4 }}>{p.title}</p>
            <p style={{ fontSize: 12.5, color: "var(--text-soft)", lineHeight: 1.5 }}>{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  );
}

/* =======================================================================
   SIDEBAR / NAV
======================================================================= */
const NAV_ITEMS = [
  { id: "shop", label: "Shop", icon: "bag" },
  { id: "foryou", label: "For You", icon: "sparkle" },
  { id: "wishlist", label: "Wishlist", icon: "star" },
  { id: "lookbook", label: "Lookbook", icon: "flower" },
  { id: "cart", label: "My Bag", icon: "sparkle" },
  { id: "concierge", label: "Concierge", icon: "chat" },
  { id: "wall", label: "Style Wall", icon: "camera" },
  { id: "__divider", divider: true, label: "Store Tools" },
  { id: "overview", label: "Overview", icon: "home" },
  { id: "product", label: "Product Studio", icon: "photo" },
  { id: "mood", label: "Customer Mood", icon: "heart" },
  { id: "settings", label: "Settings", icon: "gear" },
];

function Sidebar({ page, setPage, mobileOpen, setMobileOpen, items, profile, role, onSignOut }) {
  return (
    <>
      {mobileOpen && <div onClick={() => setMobileOpen(false)} style={{ position: "fixed", inset: 0, background: "rgba(47,42,53,0.28)", zIndex: 40 }} className="sidebar-backdrop" />}
      <aside style={{
        width: 250, background: "#fff", borderRight: "1px solid var(--border)",
        position: "fixed", top: 0, bottom: 0, left: 0, zIndex: 50,
        display: "flex", flexDirection: "column", padding: "26px 16px",
        transform: mobileOpen ? "translateX(0)" : undefined,
        transition: "transform 0.3s ease",
      }} className={`sidebar ${mobileOpen ? "sidebar-open" : ""}`}>
        <div style={{ display: "flex", alignItems: "center", gap: 10, padding: "0 10px 24px", borderBottom: "1px solid var(--border)", marginBottom: 18 }}>
          <div style={{ width: 34, height: 34, borderRadius: "50%", background: "linear-gradient(135deg, var(--pink), #FFB2D6)", display: "flex", alignItems: "center", justifyContent: "center", color: "#fff" }}>
            <Icon name="flower" size={17} />
          </div>
          <span style={{ fontFamily: "'Playfair Display', serif", fontWeight: 700, fontSize: 16.5 }}>Bubblegum Atelier</span>
        </div>

        <nav style={{ display: "flex", flexDirection: "column", gap: 3, flex: 1 }}>
          {(items || NAV_ITEMS).map((item) => {
            if (item.divider) return (
              <p key={item.id} style={{ margin: "18px 12px 8px", fontSize: 11, fontWeight: 700, letterSpacing: 1.5, color: "var(--text-soft)", textTransform: "uppercase" }}>{item.label}</p>
            );
            const active = page === item.id;
            return (
              <button key={item.id} onClick={() => { setPage(item.id); setMobileOpen(false); }}
                style={{
                  display: "flex", alignItems: "center", gap: 12, padding: "11px 14px", borderRadius: 13,
                  border: "none", background: active ? "var(--pink-soft)" : "transparent",
                  color: active ? "var(--pink-dark)" : "var(--text)", fontWeight: active ? 700 : 500,
                  fontSize: 14, textAlign: "left", transition: "background 0.25s ease, color 0.25s ease",
                }}
                className="nav-item"
              >
                <Icon name={item.icon} size={18} />
                {item.label}
              </button>
            );
          })}
        </nav>

        <div style={{ borderTop: "1px solid var(--border)", paddingTop: 16, marginTop: 10 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 10, padding: "8px 10px" }}>
            <div style={{ width: 30, height: 30, borderRadius: "50%", background: "var(--lavender)", display: "flex", alignItems: "center", justifyContent: "center", color: "var(--pink-dark)", fontWeight: 700, fontSize: 13 }}>
              {profile ? profile.name.charAt(0).toUpperCase() : <Icon name="user" size={15} />}
            </div>
            <div style={{ flex: 1 }}>
              <p style={{ fontSize: 12.5, fontWeight: 700 }}>{profile ? profile.name : "Guest"}</p>
              <p style={{ fontSize: 11, color: "var(--text-soft)" }}>{role === "owner" ? "Boutique Owner" : profile ? "Shopper" : "Guest browsing"}</p>
            </div>
          </div>
          <button onClick={onSignOut} style={{ width: "100%", marginTop: 4, padding: "8px 10px", borderRadius: 10, border: "1px solid var(--border)", background: "#fff", color: "var(--text-soft)", fontSize: 12, cursor: "pointer" }}>
            {profile ? "Sign out / switch role" : "Exit guest mode"}
          </button>
        </div>
      </aside>
    </>
  );
}

function TopBar({ setMobileOpen, title }) {
  return (
    <div className="topbar" style={{ display: "none", alignItems: "center", gap: 12, padding: "16px 20px", position: "sticky", top: 0, background: "rgba(255,248,250,0.92)", backdropFilter: "blur(6px)", zIndex: 30, borderBottom: "1px solid var(--border)" }}>
      <button onClick={() => setMobileOpen(true)} style={{ background: "#fff", border: "1px solid var(--border)", borderRadius: 12, width: 38, height: 38, display: "flex", alignItems: "center", justifyContent: "center", color: "var(--pink-dark)" }}>
        <Icon name="menu" size={18} />
      </button>
      <span style={{ fontFamily: "'Playfair Display', serif", fontWeight: 700, fontSize: 16 }}>{title}</span>
    </div>
  );
}

/* =======================================================================
   PAGE: BOUTIQUE OVERVIEW
======================================================================= */
const FUNNEL_COLORS = { view: "#F9A8D4", cart_add: "#F472B6", wishlist_add: "#EC4899", checkout_intent: "#DB2777", purchase: "#BE185D" };

function FunnelCard() {
  const [st, setSt] = useState({ loading: true, data: null, error: null });
  const [tick, setTick] = useState(0);
  useEffect(() => {
    api.funnel().then((res) => {
      if (res.ok) setSt({ loading: false, data: res.data, error: null });
      else setSt({ loading: false, data: null, error: res.message });
    });
  }, [tick]);
  const d = st.data;
  const sparse = d ? d.total_events < 20 : false;
  return (
    <div className="card fade-up" style={{ padding: 26, marginBottom: 22 }}>
      <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", gap: 12, flexWrap: "wrap", marginBottom: 6 }}>
        <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
          <Icon name="sparkle" size={16} style={{ color: "var(--pink)" }} />
          <h3 style={{ fontSize: 16.5 }}>Live Shop Funnel</h3>
        </div>
        <button onClick={() => setTick(tick + 1)} style={{ display: "flex", alignItems: "center", gap: 6, border: "1px solid var(--border)", background: "#fff", borderRadius: 999, padding: "6px 13px", fontSize: 12, fontWeight: 600, color: "var(--text-soft)", cursor: "pointer" }}>
          <Icon name="refresh" size={12} /> Refresh
        </button>
      </div>
      <p style={{ fontSize: 12.5, color: "var(--text-soft)", marginBottom: 16 }}>Read live from data/events.jsonl — the notebook your shop writes in as shoppers click.</p>
      {st.loading && <LoadingState label="Reading the shop's notebook..." />}
      {!st.loading && st.error && (
        <p style={{ fontSize: 13, color: "#B91C1C", background: "#FEF2F2", borderRadius: 12, padding: "10px 14px" }}>
          Can't reach the funnel endpoint ({st.error}). Did funnel.py get created in app/routers, and the two lines go into app/main.py?
        </p>
      )}
      {!st.loading && d && (
        <div>
          {d.stages.map((s) => (
            <div key={s.key} style={{ marginBottom: 12 }}>
              <div style={{ display: "flex", justifyContent: "space-between", fontSize: 12.5, marginBottom: 4 }}>
                <span style={{ fontWeight: 600 }}>{s.label}</span>
                <span style={{ color: "var(--text-soft)" }}>{s.count} · {s.pct}%</span>
              </div>
              <div style={{ background: "var(--pink-soft)", borderRadius: 999, height: 14, overflow: "hidden" }}>
                <div style={{ width: Math.max(s.pct, s.count > 0 ? 3 : 0) + "%", height: "100%", background: FUNNEL_COLORS[s.key] || "#EC4899", borderRadius: 999, transition: "width 0.4s ease" }} />
              </div>
            </div>
          ))}
          <div style={{ display: "flex", gap: 8, flexWrap: "wrap", marginTop: 14, alignItems: "center" }}>
            <span style={{ fontSize: 12, fontWeight: 600, padding: "5px 12px", borderRadius: 999, background: "var(--cream)", color: "var(--pink-dark)", display: "flex", alignItems: "center", gap: 6 }}>
              <Icon name="bag" size={12} /> {d.pending_carts} bag{d.pending_carts === 1 ? "" : "s"} pending (added, not checked out)
            </span>
            <span style={{ fontSize: 11.5, color: "var(--text-soft)" }}>{d.total_events} real events recorded so far</span>
          </div>
          {sparse && (
            <p style={{ fontSize: 12, color: "var(--text-soft)", background: "var(--cream)", borderRadius: 12, padding: "10px 14px", marginTop: 12, lineHeight: 1.5 }}>
              This funnel counts only real clicks — no demo numbers. It starts filling as people browse: every shop visit logs product views, so the first bar grows fastest. Purchases stay at 0 until a payment step exists — for now the shop honestly records checkout intent.
            </p>
          )}
        </div>
      )}
    </div>
  );
}

function OverviewPage({ session }) {
  const [state, setState] = useState({ loading: true, error: null, data: null });
  const [reviewMood, setReviewMood] = useState(null);

  const load = useCallback(() => {
    setState({ loading: true, error: null, data: null });
    api.dashboardStats().then((res) => {
      if (res.ok) setState({ loading: false, error: null, data: res.data });
      else setState({ loading: false, error: res.message, data: null });
    });
  }, []);

  useEffect(() => { load(); }, [load]);

  useEffect(() => {
    api.getReviews().then((res) => {
      if (res.ok) {
        const counts = {};
        res.data.reviews.forEach((r) => { counts[r.sentiment] = (counts[r.sentiment] || 0) + 1; });
        if (Object.keys(counts).length) setReviewMood(counts);
      }
    });
  }, []);

  const hour = new Date().getHours();
  const greeting = hour < 12 ? "Good Morning" : hour < 18 ? "Good Afternoon" : "Good Evening";

  const sentimentMap = { positive: { label: "Loved It", color: "#FF6FAE" }, neutral: { label: "Mixed Feelings", color: "#B9A8FF" }, negative: { label: "Needs Attention", color: "#8FD9BE" } };

  let segments = [];
  let hasSentiment = false;
  const sbMerged = reviewMood || (state.data && state.data.sentiment_breakdown) || null;
  if (sbMerged) {
    const sb = sbMerged;
    segments = Object.keys(sb).filter(k => sentimentMap[k]).map(k => ({ key: k, value: sb[k], label: sentimentMap[k].label, color: sentimentMap[k].color }));
    hasSentiment = segments.some(s => s.value > 0);
  }

  const insightCards = [
    "Lipstick reviews are trending positive this week.",
    "Bags remain the most-photographed category in the studio.",
    "Guests recognized at the door tend to browse accessories first.",
    "Playful, story-driven captions get the warmest customer replies.",
  ];

  return (
    <div>
      <div className="card fade-up" style={{ padding: "30px 28px", marginBottom: 22, background: "linear-gradient(135deg, var(--cream), #fff)", position: "relative", overflow: "hidden" }}>
        <div style={{ position: "absolute", right: -20, top: -20, opacity: 0.12, color: "var(--pink)" }}><Icon name="flower" size={140} /></div>
        <p style={{ color: "var(--pink-dark)", fontWeight: 700, fontSize: 13, letterSpacing: 0.4, marginBottom: 6 }}>{greeting.toUpperCase()}</p>
        <h2 style={{ fontSize: 28, marginBottom: 6 }}>Here's how your boutique is doing today</h2>
        <p style={{ color: "var(--text-soft)", fontSize: 14 }}>A gentle pulse on visits, guests, and the moods behind every review.</p>
      </div>

      {state.loading && <LoadingState label="Styling your dashboard..." />}
      {state.error && <ErrorState message={state.error} onRetry={load} />}

      {!state.loading && !state.error && state.data && (
        <>
          <FunnelCard />
          <div className="grid-3 fade-up" style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(200px, 1fr))", gap: 16, marginBottom: 22 }}>
            <StatCard icon="bag" label="Total Visits" value={state.data.total_visits || 0} bg="var(--pink-soft)" />
            <StatCard icon="user" label="Unique Customers" value={state.data.unique_customers || 0} bg="var(--mint)" />
            <StatCard icon="photo" label="Products Tagged" value={session.classifyCount} bg="var(--lavender)" note="This session" />
            <StatCard icon="chat" label="Concierge Chats" value={session.chatCount} bg="var(--cream)" note="This session" />
          </div>

          <div style={{ display: "grid", gridTemplateColumns: "1.1fr 1fr", gap: 18 }} className="two-col">
            <div className="card fade-up" style={{ padding: 26 }}>
              <div style={{ display: "flex", alignItems: "center", gap: 8, marginBottom: 18 }}>
                <Icon name="heart" size={17} style={{ color: "var(--pink)" }} />
                <h3 style={{ fontSize: 16.5 }}>Customer Mood Breakdown</h3>
              </div>
              {!hasSentiment ? (
                <EmptyState icon="flower" title="No customer reviews yet" subtitle="Your boutique is waiting for its first story." />
              ) : (
                <div style={{ display: "flex", alignItems: "center", gap: 26, flexWrap: "wrap" }}>
                  <Donut segments={segments.map(s => ({ value: s.value, color: s.color }))} />
                  <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                    {segments.map((s, i) => (
                      <div key={i} style={{ display: "flex", alignItems: "center", gap: 8, fontSize: 13.5 }}>
                        <span style={{ width: 10, height: 10, borderRadius: "50%", background: s.color, display: "inline-block" }} />
                        <span style={{ fontWeight: 600 }}>{s.label}</span>
                        <span style={{ color: "var(--text-soft)" }}>({s.value})</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>

            <div className="card fade-up" style={{ padding: 26 }}>
              <div style={{ display: "flex", alignItems: "center", gap: 8, marginBottom: 16 }}>
                <Icon name="sparkle" size={17} style={{ color: "var(--pink)" }} />
                <h3 style={{ fontSize: 16.5 }}>AI Insights</h3>
              </div>
              <p style={{ fontSize: 12, color: "var(--text-soft)", marginBottom: 14 }}>Illustrative observations - a preview of what deeper analysis could surface.</p>
              <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                {insightCards.map((t, i) => (
                  <div key={i} style={{ display: "flex", gap: 10, alignItems: "flex-start", padding: "12px 14px", background: "var(--cream)", borderRadius: 14 }}>
                    <Icon name="star" size={14} style={{ color: "var(--pink)", marginTop: 2, flexShrink: 0 }} />
                    <p style={{ fontSize: 13, lineHeight: 1.5 }}>{t}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </>
      )}
    </div>
  );
}

function StatCard({ icon, label, value, bg, note }) {
  return (
    <div className="card" style={{ padding: "20px 20px" }}>
      <div style={{ width: 38, height: 38, borderRadius: "50%", background: bg, display: "flex", alignItems: "center", justifyContent: "center", color: "var(--pink-dark)", marginBottom: 14 }}>
        <Icon name={icon} size={17} />
      </div>
      <p style={{ fontSize: 26, fontFamily: "'Playfair Display', serif", fontWeight: 700 }}><StatNumber value={value} /></p>
      <p style={{ fontSize: 12.5, color: "var(--text-soft)", fontWeight: 500 }}>{label}{note && <span style={{ marginLeft: 6, fontSize: 10.5, color: "var(--pink-dark)", background: "var(--pink-soft)", padding: "2px 7px", borderRadius: 999 }}>{note}</span>}</p>
    </div>
  );
}

/* =======================================================================
   PAGE: PRODUCT STUDIO
======================================================================= */
function ProductStudioPage({ onClassified }) {
  const [file, setFile] = useState(null);
  const [preview, setPreview] = useState(null);
  const [loading, setLoading] = useState(false);
  const [result, setResult] = useState(null);
  const [error, setError] = useState(null);
  const [dragOver, setDragOver] = useState(false);
  const inputRef = useRef(null);

  const categoryIcon = { shoes: "shoe", bags: "bag", clothing: "hanger", accessories: "flower", makeup: "lipstick" };

  function handleFile(f) {
    if (!f) return;
    setFile(f);
    setPreview(URL.createObjectURL(f));
    setResult(null);
    setError(null);
  }

  function submit() {
    if (!file) return;
    setLoading(true); setResult(null); setError(null);
    api.classifyProduct(file).then((res) => {
      setLoading(false);
      if (res.ok) {
        setResult(res.data);
        onClassified();
      } else if (res.status === 503) {
        setResult(res.data || { status: "not_trained", message: res.message });
        onClassified();
      } else {
        setError(res.message);
      }
    });
  }

  function reset() { setFile(null); setPreview(null); setResult(null); setError(null); }

  return (
    <div>
      <PageHeader icon="bag" title="Product Studio" subtitle="Drop in a product photo and let the studio recognize its category." />

      <div className="card fade-up" style={{ padding: 28, maxWidth: 620 }}>
        {!preview ? (
          <div
            onDragOver={(e) => { e.preventDefault(); setDragOver(true); }}
            onDragLeave={() => setDragOver(false)}
            onDrop={(e) => { e.preventDefault(); setDragOver(false); handleFile(e.dataTransfer.files[0]); }}
            onClick={() => inputRef.current.click()}
            style={{
              border: `2px dashed ${dragOver ? "var(--pink)" : "var(--pink-soft)"}`, borderRadius: 18,
              padding: "50px 20px", textAlign: "center", cursor: "pointer",
              background: dragOver ? "var(--cream)" : "#FFFBFC", transition: "all 0.2s ease",
            }}
          >
            <div style={{ width: 52, height: 52, borderRadius: "50%", background: "var(--pink-soft)", display: "flex", alignItems: "center", justifyContent: "center", margin: "0 auto 14px", color: "var(--pink-dark)" }}>
              <Icon name="cloud" size={24} />
            </div>
            <p style={{ fontWeight: 700, marginBottom: 4 }}>Drop a product photo here</p>
            <p style={{ fontSize: 13, color: "var(--text-soft)" }}>or <span style={{ color: "var(--pink-dark)", fontWeight: 600 }}>Browse Lookbook</span></p>
            <input ref={inputRef} type="file" accept="image/*" style={{ display: "none" }} onChange={(e) => handleFile(e.target.files[0])} />
          </div>
        ) : (
          <div>
            <div style={{ borderRadius: 16, overflow: "hidden", border: "1px solid var(--border)", marginBottom: 18, animation: "popIn 0.4s ease" }}>
              <img src={preview} alt="preview" style={{ width: "100%", maxHeight: 360, objectFit: "cover", display: "block" }} />
            </div>
            <div style={{ display: "flex", gap: 10 }}>
              <button className="btn" disabled={loading} onClick={submit} style={{ flex: 1 }}>
                {loading ? "Identifying..." : <><Icon name="sparkle" size={15} /> Identify Product</>}
              </button>
              <button className="btn btn-ghost" onClick={reset}><Icon name="x" size={15} /> Clear</button>
            </div>
          </div>
        )}

        {loading && <div style={{ marginTop: 18 }}><LoadingState label="Scanning the details..." /></div>}
        {error && <div style={{ marginTop: 18 }}><ErrorState message={error} onRetry={submit} /></div>}

        {result && !loading && (
          <div className="fade-up" style={{ marginTop: 18, position: "relative" }}>
            <Sparkles show={true} />
            {result.status === "not_trained" ? (
              <div style={{ padding: 20, borderRadius: 16, background: "var(--lavender)", textAlign: "center" }}>
                <Icon name="sparkle" size={22} style={{ color: "var(--pink-dark)", marginBottom: 8 }} />
                <p style={{ fontWeight: 700, marginBottom: 4 }}>Still learning this one</p>
                <p style={{ fontSize: 13, color: "var(--text-soft)" }}>{result.message}</p>
              </div>
            ) : (
              <div style={{ padding: 22, borderRadius: 16, background: "var(--mint)" }}>
                <p style={{ fontWeight: 700, fontSize: 15, marginBottom: 14 }}><Icon name="check" size={15} /> Product Identified</p>
                <div style={{ display: "flex", alignItems: "center", gap: 12, marginBottom: 16 }}>
                  <div style={{ width: 40, height: 40, borderRadius: "50%", background: "#fff", display: "flex", alignItems: "center", justifyContent: "center", color: "var(--pink-dark)" }}>
                    <Icon name={categoryIcon[result.category] || "sparkle"} size={19} />
                  </div>
                  <div>
                    <p style={{ fontSize: 12, color: "var(--text-soft)" }}>Category</p>
                    <p style={{ fontWeight: 700, fontSize: 16, textTransform: "capitalize" }}>{result.category}</p>
                  </div>
                </div>
                <p style={{ fontSize: 12, color: "var(--text-soft)", marginBottom: 6 }}>Confidence: {Math.round((result.confidence || 0) * 100)}%</p>
                <ConfidenceBar percent={Math.round((result.confidence || 0) * 100)} color="var(--pink)" trackColor="#fff" />
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  );
}

/* =======================================================================
   PAGE: CUSTOMER MOOD
======================================================================= */
function ShopperReviewsFeed() {
  const [st, setSt] = useState({ loading: true, error: null, reviews: [], names: {} });
  const [tick, setTick] = useState(0);
  useEffect(() => {
    setSt((s) => ({ ...s, loading: true, error: null }));
    Promise.all([api.getReviews(), api.getProducts()]).then(([rv, pr]) => {
      const names = {};
      if (pr.ok) pr.data.products.forEach((p) => { names[p.id] = p.name; });
      if (rv.ok) setSt({ loading: false, error: null, reviews: rv.data.reviews, names });
      else setSt({ loading: false, error: rv.message, reviews: [], names });
    });
  }, [tick]);
  const total = st.reviews.length;
  const loved = st.reviews.filter((r) => r.sentiment === "positive").length;
  const needy = st.reviews.filter((r) => r.sentiment === "negative").length;
  return (
    <div className="card fade-up" style={{ padding: 26, marginBottom: 22 }}>
      <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", gap: 12, flexWrap: "wrap", marginBottom: 14 }}>
        <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
          <Icon name="chat" size={16} style={{ color: "var(--pink)" }} />
          <h3 style={{ fontSize: 16.5 }}>What shoppers are saying</h3>
        </div>
        <button onClick={() => setTick(tick + 1)} style={{ display: "flex", alignItems: "center", gap: 6, border: "1px solid var(--border)", background: "#fff", borderRadius: 999, padding: "6px 13px", fontSize: 12, fontWeight: 600, color: "var(--text-soft)", cursor: "pointer" }}>
          <Icon name="refresh" size={12} /> Refresh
        </button>
      </div>
      {total > 0 && (
        <div style={{ display: "flex", gap: 8, flexWrap: "wrap", marginBottom: 16 }}>
          <span style={{ fontSize: 12, fontWeight: 600, padding: "5px 12px", borderRadius: 999, background: "var(--cream)", color: "var(--pink-dark)" }}>{total} review{total === 1 ? "" : "s"}</span>
          <span style={{ fontSize: 12, fontWeight: 600, padding: "5px 12px", borderRadius: 999, background: "var(--pink-soft)", color: SENT_LOOKUP.positive.color }}>{Math.round(loved / total * 100)}% Loved It</span>
          {needy > 0 && <span style={{ fontSize: 12, fontWeight: 600, padding: "5px 12px", borderRadius: 999, background: "var(--mint)", color: SENT_LOOKUP.negative.color }}>{Math.round(needy / total * 100)}% Needs Love</span>}
        </div>
      )}
      {st.loading && <LoadingState label="Listening for shopper whispers..." />}
      {!st.loading && st.error && <ErrorState message={st.error} onRetry={() => setTick(tick + 1)} />}
      {!st.loading && !st.error && total === 0 && (
        <EmptyState icon="heart" title="No whispers yet" subtitle="Reviews land here the moment a shopper taps Send under any product. Go leave one as a shopper and watch this page come alive!" />
      )}
      {!st.loading && !st.error && total > 0 && (
        <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(300px, 1fr))", gap: 14 }}>
          {st.reviews.slice(0, 12).map((r) => {
            const s = SENT_LOOKUP[r.sentiment] || { label: r.sentiment || "Unrated", color: "var(--text-soft)" };
            return (
              <div key={r.id} style={{ border: "1px solid var(--border)", borderRadius: 14, padding: 14, background: "#fff" }}>
                <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", gap: 8, marginBottom: 8, flexWrap: "wrap" }}>
                  <span style={{ fontSize: 11.5, fontWeight: 700, padding: "3px 10px", borderRadius: 999, background: "var(--pink-soft)", color: s.color }}>{s.label}{r.confidence ? " · " + Math.round(r.confidence * 100) + "% sure" : ""}</span>
                  <span style={{ fontSize: 11, color: "var(--text-soft)" }}>{(r.timestamp || "").slice(0, 16).replace("T", " ")}</span>
                </div>
                <p style={{ fontSize: 13, lineHeight: 1.5, marginBottom: 8 }}>"{r.text}"</p>
                <p style={{ fontSize: 11.5, color: "var(--text-soft)" }}>
                  <b>{st.names[r.product_id] || "the boutique"}</b>{r.customer ? " · by " + r.customer : ""}
                </p>
              </div>
            );
          })}
        </div>
      )}
    </div>
  );
}

function CustomerMoodPage() {
  const [text, setText] = useState("");
  const [loading, setLoading] = useState(false);
  const [result, setResult] = useState(null);
  const [error, setError] = useState(null);

  const sentimentUi = {
    positive: { icon: "heart", label: "Loved It", note: "The customer really enjoyed this product.", color: "var(--pink)", bg: "var(--pink-soft)" },
    negative: { icon: "alert", label: "Needs Attention", note: "This review signals some frustration worth following up on.", color: "#8FBBA8", bg: "var(--mint)" },
    neutral: { icon: "flower", label: "Mixed Feelings", note: "A balanced review - some parts landed, others didn't.", color: "#A997E8", bg: "var(--lavender)" },
  };

  function submit() {
    if (!text.trim()) return;
    setLoading(true); setResult(null); setError(null);
    api.analyzeSentiment(text).then((res) => {
      setLoading(false);
      if (res.ok) setResult(res.data);
      else setError(res.message);
    });
  }

  const ui = result ? sentimentUi[result.sentiment] : null;

  return (
    <div>
      <PageHeader icon="heart" title="Customer Mood" subtitle="Every shopper review from the storefront, read for mood - live." />
      <ShopperReviewsFeed />
      <div className="card fade-up" style={{ padding: 28, maxWidth: 620 }}>
        <p style={{ fontSize: 13, fontWeight: 700, marginBottom: 10, display: "flex", alignItems: "center", gap: 7 }}><Icon name="sparkle" size={14} style={{ color: "var(--pink)" }} /> Try the mood reader on any text</p>
        <textarea
          value={text} onChange={(e) => setText(e.target.value)}
          placeholder="Paste a customer review..."
          style={{ width: "100%", minHeight: 130, border: "1.5px solid var(--border)", borderRadius: 16, padding: 16, fontSize: 14.5, fontFamily: "'Inter',sans-serif", resize: "vertical", outline: "none", color: "var(--text)" }}
          onFocus={(e) => e.target.style.borderColor = "var(--pink)"}
          onBlur={(e) => e.target.style.borderColor = "var(--border)"}
        />
        <button className="btn" disabled={loading || !text.trim()} onClick={submit} style={{ marginTop: 14 }}>
          {loading ? "Reading..." : "Read Mood"}
        </button>

        {loading && <div style={{ marginTop: 18 }}><LoadingState label="Reading customer mood..." /></div>}
        {error && <div style={{ marginTop: 18 }}><ErrorState message={error} onRetry={submit} /></div>}

        {ui && !loading && (
          <div className="fade-up" style={{ marginTop: 22, padding: 22, borderRadius: 18, background: ui.bg }}>
            <div style={{ display: "flex", alignItems: "center", gap: 12, marginBottom: 14 }}>
              <div style={{ color: ui.color }}><Icon name={ui.icon} size={30} /></div>
              <div>
                <p style={{ fontWeight: 700, fontSize: 17 }}>{ui.label}</p>
                <p style={{ fontSize: 12.5, color: "var(--text-soft)" }}>{ui.note}</p>
              </div>
            </div>
            <p style={{ fontSize: 12, color: "var(--text-soft)", marginBottom: 6 }}>Confidence: {Math.round((result.confidence || 0) * 100)}%</p>
            <ConfidenceBar percent={Math.round((result.confidence || 0) * 100)} color={ui.color} trackColor="#fff" />
          </div>
        )}
      </div>
    </div>
  );
}

/* =======================================================================
   PAGE: BOUTIQUE CONCIERGE
======================================================================= */
function ConciergePage({ onMessage }) {
  const [messages, setMessages] = useState([
    { role: "bot", text: "Hello! I'm your Boutique Concierge. Ask me about returns, shipping, opening hours, or products." },
  ]);
  const [input, setInput] = useState("");
  const [typing, setTyping] = useState(false);
  const [error, setError] = useState(null);
  const scrollRef = useRef(null);

  useEffect(() => { if (scrollRef.current) scrollRef.current.scrollTop = scrollRef.current.scrollHeight; }, [messages, typing]);

  function send(text) {
    const t = (text || input).trim();
    if (!t) return;
    setMessages((m) => [...m, { role: "user", text: t }]);
    setInput("");
    setTyping(true);
    setError(null);
    api.chatbot(t).then((res) => {
      setTyping(false);
      if (res.ok) {
        setMessages((m) => [...m, { role: "bot", text: res.data.reply }]);
        onMessage();
      } else {
        setError(res.message);
      }
    });
  }

  const chips = ["Store Hours", "Returns", "Shipping", "Gift Cards"];

  return (
    <div>
      <PageHeader icon="chat" title="Boutique Concierge" subtitle="Your AI front-desk for quick customer questions." />
      <div className="card fade-up" style={{ maxWidth: 640, display: "flex", flexDirection: "column", height: 560 }}>
        <div ref={scrollRef} style={{ flex: 1, overflowY: "auto", padding: 22, display: "flex", flexDirection: "column", gap: 12 }}>
          {messages.map((m, i) => (
            <div key={i} style={{ display: "flex", gap: 8, alignItems: "flex-end", flexDirection: m.role === "user" ? "row-reverse" : "row", animation: "slideIn 0.3s ease both" }}>
              {m.role === "bot" && (
                <div style={{ width: 30, height: 30, borderRadius: "50%", background: "var(--pink-soft)", display: "flex", alignItems: "center", justifyContent: "center", color: "var(--pink-dark)", flexShrink: 0 }}>
                  <Icon name="sparkle" size={14} />
                </div>
              )}
              <div style={{
                maxWidth: "75%", padding: "11px 16px", borderRadius: m.role === "user" ? "18px 18px 4px 18px" : "18px 18px 18px 4px",
                background: m.role === "user" ? "var(--pink)" : "var(--cream)",
                color: m.role === "user" ? "#fff" : "var(--text)",
                fontSize: 13.5, lineHeight: 1.5,
              }}>{m.text}</div>
            </div>
          ))}
          {typing && (
            <div style={{ display: "flex", gap: 8, alignItems: "center" }}>
              <div style={{ width: 30, height: 30, borderRadius: "50%", background: "var(--pink-soft)", display: "flex", alignItems: "center", justifyContent: "center", color: "var(--pink-dark)" }}>
                <Icon name="sparkle" size={14} />
              </div>
              <div style={{ padding: "11px 16px", borderRadius: "18px 18px 18px 4px", background: "var(--cream)", fontSize: 13, color: "var(--text-soft)", animation: "pulseSoft 1.3s ease-in-out infinite" }}>Thinking...</div>
            </div>
          )}
          {error && <ErrorState message={error} onRetry={() => send(messages[messages.length-1]?.text)} />}
        </div>

        <div style={{ padding: "0 18px 12px", display: "flex", gap: 8, flexWrap: "wrap" }}>
          {chips.map((c) => (
            <button key={c} onClick={() => send(c)} style={{ padding: "7px 14px", borderRadius: 999, border: "1px solid var(--pink-soft)", background: "#fff", color: "var(--pink-dark)", fontSize: 12.5, fontWeight: 600 }}>{c}</button>
          ))}
        </div>

        <div style={{ borderTop: "1px solid var(--border)", padding: 14, display: "flex", gap: 10 }}>
          <input value={input} onChange={(e) => setInput(e.target.value)} onKeyDown={(e) => e.key === "Enter" && send()}
            placeholder="Ask about returns, shipping, hours..."
            style={{ flex: 1, border: "1.5px solid var(--border)", borderRadius: 999, padding: "11px 18px", fontSize: 13.5, outline: "none" }}
            onFocus={(e) => e.target.style.borderColor = "var(--pink)"}
            onBlur={(e) => e.target.style.borderColor = "var(--border)"}
          />
          <button className="btn" style={{ padding: "0 18px", height: 42, width: 42, borderRadius: "50%" }} onClick={() => send()}>
            <Icon name="send" size={16} />
          </button>
        </div>
      </div>
    </div>
  );
}

/* =======================================================================
   PAGE: AI INSIGHTS (standalone)
======================================================================= */
function InsightsPage() {
  const insights = [
    { icon: "lipstick", title: "Makeup reviews trending warm", text: "Recent feedback around makeup items leans positive - a nice thread to feature in your next newsletter." },
    { icon: "bag", title: "Bags draw the most attention", text: "Bags are the most-photographed category in Product Studio this week." },
    { icon: "photo", title: "Returning guests browse longer", text: "Recognized guests tend to explore more categories per visit than new visitors." },
    { icon: "chat", title: "Shipping is the top question", text: "Shipping and returns are the most common concierge topics - consider pinning them in-store too." },
  ];
  return (
    <div>
      <PageHeader icon="sparkle" title="AI Insights" subtitle="Illustrative observations to spark ideas - not live analytics yet." />
      <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(260px, 1fr))", gap: 16 }}>
        {insights.map((c, i) => (
          <div key={i} className="card fade-up" style={{ padding: 22, animationDelay: `${i * 0.05}s` }}>
