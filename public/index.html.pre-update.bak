              <Icon name={c.icon} size={17} />
            </div>
            <p style={{ fontWeight: 700, fontSize: 14.5, marginBottom: 6 }}>{c.title}</p>
            <p style={{ fontSize: 13, color: "var(--text-soft)", lineHeight: 1.55 }}>{c.text}</p>
          </div>
        ))}
      </div>
    </div>
  );
}

