        </div>
      </div>
      <div className="card fade-up" style={{ padding: 26, maxWidth: 560, marginTop: 16 }}>
        <p style={{ fontSize: 13.5, color: "var(--text-soft)" }}>Team management, notification preferences, and theme options are on their way. For now, reach out to your studio admin for account changes.</p>
      </div>
    </div>
  );
}

/* =======================================================================
   PAGE HEADER
======================================================================= */
function PageHeader({ icon, title, subtitle }) {
  return (
    <div className="fade-up" style={{ display: "flex", alignItems: "center", gap: 12, marginBottom: 24 }}>
      <div style={{ width: 42, height: 42, borderRadius: "50%", background: "var(--pink-soft)", display: "flex", alignItems: "center", justifyContent: "center", color: "var(--pink-dark)" }}>
        <Icon name={icon} size={19} />
      </div>
      <div>
        <h2 style={{ fontSize: 22 }}>{title}</h2>
        <p style={{ fontSize: 13, color: "var(--text-soft)" }}>{subtitle}</p>
      </div>
    </div>
  );
}

/* =======================================================================
   PAGE: SHOP
======================================================================= */
const CAT_LABELS = { shoes: "Shoes", bags: "Bags", tops: "Tops", bottoms: "Bottoms", dresses: "Dresses", accessories: "Accessories", makeup: "Makeup" };
const CAT_ORDER = ["shoes", "bags", "tops", "bottoms", "dresses", "accessories", "makeup"];
const SENT_LOOKUP = { positive: { label: "Loved It", color: "#EC4899" }, neutral: { label: "Mixed Feelings", color: "#8B7CE8" }, negative: { label: "Needs Love", color: "#22996F" } };

function ProductModal({ p, onClose, onAdd, addedId, wishlisted, onWish }) {
  const [zoom, setZoom] = useState(false);
  const [origin, setOrigin] = useState("50% 50%");
  const [chosen, setChosen] = useState(p.sizes && p.sizes.length === 1 ? p.sizes[0] : null);
  const [needSize, setNeedSize] = useState(false);
  const [rvText, setRvText] = useState("");
  const [rvList, setRvList] = useState(null);
  const [rvDone, setRvDone] = useState(null);
  const [rvSending, setRvSending] = useState(false);
  useEffect(() => { setChosen(p.sizes && p.sizes.length === 1 ? p.sizes[0] : null); setNeedSize(false); setZoom(false); }, [p.id]);
  useEffect(() => {
    logEvent("view", p.id, { context: "product_modal" });
    setRvList(null); setRvDone(null); setRvText("");
    api.getReviews(p.id).then((res) => { if (res.ok) setRvList(res.data.reviews); });
    const h = (e) => { if (e.key === "Escape") onClose(); };
    window.addEventListener("keydown", h);
    return () => window.removeEventListener("keydown", h);
  }, [p.id, onClose]);
  function submitReview() {
    if (!rvText.trim()) return;
    setRvSending(true);
    const prof = typeof getProfile === "function" ? getProfile() : null;
    api.addReview(p.id, rvText.trim(), prof && prof.name ? prof.name : null).then((res) => {
      setRvSending(false);
      if (res.ok) {
        setRvDone(res.data.sentiment || "positive");
        setRvText("");
        api.getReviews(p.id).then((r2) => { if (r2.ok) setRvList(r2.data.reviews); });
      } else alert(res.message || "Couldn't save your review.");
    });
  }
  return ReactDOM.createPortal(
    <div onClick={onClose} style={{ position: "fixed", top: 0, left: 0, right: 0, bottom: 0, background: "rgba(90,20,50,0.35)", backdropFilter: "blur(4px)", zIndex: 70, display: "flex", alignItems: "center", justifyContent: "center", padding: 20 }}>
      <div onClick={(e) => e.stopPropagation()} className="fade-up" style={{ background: "#fff", borderRadius: 22, boxShadow: "var(--shadow)", maxWidth: 780, width: "100%", maxHeight: "90vh", overflowY: "auto", padding: 22, position: "relative" }}>
        <button onClick={onClose} style={{ position: "absolute", top: 14, right: 14, width: 32, height: 32, borderRadius: "50%", border: "1px solid var(--border)", background: "#fff", cursor: "pointer", color: "var(--text-soft)", display: "flex", alignItems: "center", justifyContent: "center", zIndex: 2 }}><Icon name="x" size={15} /></button>
        <div style={{ display: "flex", gap: 22, flexWrap: "wrap" }}>
          <div
            onClick={() => setZoom(!zoom)}
            onMouseMove={(e) => { const r = e.currentTarget.getBoundingClientRect(); setOrigin(((e.clientX - r.left) / r.width * 100) + "% " + ((e.clientY - r.top) / r.height * 100) + "%"); }}
            title={zoom ? "Click to zoom out" : "Click to zoom in"}
            style={{ flex: "1 1 300px", height: 340, borderRadius: 16, overflow: "hidden", background: "var(--pink-soft)", cursor: zoom ? "zoom-out" : "zoom-in" }}>
            <img src={API_CONFIG.baseUrl + p.image} alt={p.name} style={{ width: "100%", height: "100%", objectFit: "cover", transform: zoom ? "scale(2.4)" : "scale(1)", transformOrigin: origin, transition: "transform 0.18s ease", display: "block" }} />
          </div>
          <div style={{ flex: "1 1 260px", minWidth: 240 }}>
            <span style={{ fontSize: 11, fontWeight: 700, letterSpacing: 1, textTransform: "uppercase", color: "var(--pink)" }}>{CAT_LABELS[p.category] || p.category}</span>
            <h3 style={{ fontSize: 21, margin: "6px 0 4px" }}>{p.name}</h3>
            <p style={{ fontWeight: 700, fontSize: 18, marginBottom: 10 }}>{"₹"}{p.price}</p>
            <p style={{ fontSize: 13.5, color: "var(--text-soft)", lineHeight: 1.5, marginBottom: 14 }}>{p.description}</p>
            {p.sizes && p.sizes.length > 0 && (
              <div style={{ marginBottom: 16 }}>
                <div style={{ display: "flex", gap: 6, flexWrap: "wrap" }}>
                  {p.sizes.map((s) => (
                    <button key={s} onClick={() => { setChosen(s); setNeedSize(false); }} style={{ fontSize: 12, padding: "5px 12px", borderRadius: 999, cursor: "pointer", border: chosen === s ? "1px solid var(--pink)" : "1px solid var(--border)", background: chosen === s ? "var(--pink)" : "#fff", color: chosen === s ? "#fff" : "var(--text-soft)", fontWeight: 600, transition: "all 0.12s ease" }}>{s}</button>
                  ))}
                </div>
                {needSize && <p style={{ fontSize: 12, color: "#FF1E2C", marginTop: 6, fontWeight: 600 }}>Pick a size first, cutie!</p>}
              </div>
            )}
            {p.in_stock ? (
              <button className="btn" onClick={() => { if (p.sizes && p.sizes.length > 0 && !chosen) { setNeedSize(true); return; } onAdd(p, chosen); }} style={{ width: "100%", marginBottom: 8 }}>
                {addedId === p.id ? "Added to your bag" : "Add to Bag"}
              </button>
            ) : (
              <p style={{ fontSize: 13, color: "var(--text-soft)", textAlign: "center", marginBottom: 8 }}>Out of stock</p>
            )}
            <button onClick={() => onWish(p)} style={{ width: "100%", padding: "9px 0", borderRadius: 12, border: wishlisted ? "1px solid #FF1E3C" : "1px solid var(--border)", background: wishlisted ? "#FFF0F2" : "#fff", color: wishlisted ? "#FF1E2C" : "var(--text-soft)", fontWeight: 600, fontSize: 13, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", gap: 7 }}>
              <Icon name="heart" size={14} fill={wishlisted ? "#FF1E2C" : "none"} /> {wishlisted ? "Saved in your Wishlist" : "Save to Wishlist"}
            </button>
            <p style={{ fontSize: 11.5, color: "var(--text-soft)", marginTop: 12, display: "flex", alignItems: "center", gap: 6 }}><Icon name="sparkle" size={12} /> Click the photo to zoom in and look closer.</p>
            <div style={{ borderTop: "1px solid var(--border)", marginTop: 14, paddingTop: 12 }}>
              <p style={{ fontSize: 12.5, fontWeight: 700, marginBottom: 6 }}>Tell the boutique what you think</p>
              {rvDone ? (
                <p style={{ fontSize: 12, color: "var(--text-soft)", background: "var(--pink-soft)", borderRadius: 10, padding: "8px 12px", lineHeight: 1.5 }}>
                  The boutique heard you — the mood it read: <b style={{ color: (SENT_LOOKUP[rvDone] || {}).color || "var(--pink)" }}>{(SENT_LOOKUP[rvDone] || {}).label || rvDone}</b>. Thank you!
                </p>
              ) : (
                <div style={{ display: "flex", gap: 8 }}>
                  <input value={rvText} onChange={(e) => setRvText(e.target.value)} placeholder="One line about this piece..." style={{ flex: 1, border: "1px solid var(--border)", borderRadius: 10, padding: "8px 12px", fontSize: 12.5, outline: "none", color: "inherit" }} />
                  <button className="btn btn-sm" disabled={rvSending || !rvText.trim()} onClick={submitReview} style={{ whiteSpace: "nowrap" }}>{rvSending ? "..." : "Send"}</button>
                </div>
              )}
              {rvList && rvList.length > 0 && (
                <div style={{ marginTop: 10 }}>
                  <p style={{ fontSize: 11, fontWeight: 700, color: "var(--text-soft)", letterSpacing: 0.4, marginBottom: 6 }}>WHAT SHOPPERS WHISPER</p>
                  {rvList.slice(0, 3).map((r) => (
                    <div key={r.id} style={{ fontSize: 12, background: "var(--cream)", borderRadius: 10, padding: "7px 11px", marginBottom: 6, lineHeight: 1.45 }}>
                      "{r.text}"
                      <span style={{ display: "block", marginTop: 3, fontSize: 10.5, fontWeight: 700, color: (SENT_LOOKUP[r.sentiment] || {}).color || "var(--text-soft)" }}>{(SENT_LOOKUP[r.sentiment] || {}).label || r.sentiment}{r.customer ? " · " + r.customer : ""}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>,
    document.body
  );
}

function ForYouPage({ cart, setCart, wishlist, setWishlist }) {
  const [state, setState] = useState({ loading: true, error: null, products: [] });
  const [toast, setToast] = useState(null);
  const [addedId, setAddedId] = useState(null);
  const [openId, setOpenId] = useState(null);
  const [resetting, setResetting] = useState(false);
  const [resetMsg, setResetMsg] = useState(null);

  const load = useCallback(() => {
    setState({ loading: true, error: null, products: [] });
    api.getProducts().then((res) => {
      if (res.ok) setState({ loading: false, error: null, products: res.data.products });
      else setState({ loading: false, error: res.message, products: [] });
    });
  }, []);

  useEffect(() => { load(); }, [load]);

  function toggleFav(p) {
    const has = wishlist.includes(p.id);
    const call = has ? api.favRemove(p.id) : api.favAdd(p.id);
    call.then((res) => {
      if (res.ok) {
        setWishlist(res.data.favorites);
        logEvent(has ? "wishlist_remove" : "wishlist_add", p.id, { context: "for_you" });
      } else alert(res.message || "Couldn't update wishlist.");
    });
  }

  function addToCart(p, size = null) {
    api.cartAdd(p.id, 1, size).then((res) => {
      if (res.ok) {
        setCart(res.data.items.map((i) => ({ ...i.product, qty: i.qty })));
        setToast("Added to your bag" + (size ? " · Size " + size : ""));
        setAddedId(p.id);
        logEvent("cart_add", p.id);
        setTimeout(() => setToast(null), 3000);
        setTimeout(() => setAddedId(null), 2000);
      } else alert(res.message || "Couldn't add to bag. Try again.");
    });
  }

  function resetTaste() {
    if (!wishlist.length) {
      setResetMsg("Nothing to clear yet — I'm still learning your taste.");
      setTimeout(() => setResetMsg(null), 3500);
      return;
    }
    if (!window.confirm("Clear your taste profile? This also empties your wishlist, and I start learning from zero.")) return;
    setResetting(true);
    Promise.allSettled(wishlist.map((id) => api.favRemove(id))).then(() => {
      setWishlist([]);
      setResetting(false);
      setResetMsg("Taste profile cleared — teach me again from scratch!");
      setTimeout(() => setResetMsg(null), 4000);
    });
  }

  const label = (c) => CAT_LABELS[c] || c;
  const wished = state.products.filter((p) => wishlist.includes(p.id));
  const bagIds = (cart || []).map((i) => i.id);
  const bagCats = Array.from(new Set((cart || []).map((i) => i.category)));
  const wishCats = Array.from(new Set(wished.map((p) => p.category)));
  const aff = {};
  wished.forEach((p) => { aff[p.category] = (aff[p.category] || 0) + 3; });
  (cart || []).forEach((i) => { aff[i.category] = (aff[i.category] || 0) + 4; });
  const avgWish = wished.length ? Math.round(wished.reduce((s, p) => s + p.price, 0) / wished.length) : null;
  const cold = wished.length === 0 && (cart || []).length === 0;

  function reasonFor(p) {
    const inW = wishCats.indexOf(p.category) !== -1, inB = bagCats.indexOf(p.category) !== -1;
    if (inW && inB) return "You keep coming back to " + label(p.category) + " — it's in your bag and your wishlist";
    if (inW) return "Because you wishlisted " + label(p.category);
    if (inB) return "Because your bag has " + label(p.category);
    return "A new aisle you might love next";
  }

  let picks = [];
  if (!cold) {
    picks = state.products
      .filter((p) => !wishlist.includes(p.id) && bagIds.indexOf(p.id) === -1 && p.in_stock)
      .map((p) => {
        let s = (aff[p.category] || 0) * 10;
        if (wishCats.indexOf(p.category) !== -1 && bagCats.indexOf(p.category) !== -1) s += 5;
        if (avgWish) s += Math.max(0, 3 - Math.abs(p.price - avgWish) / 1000);
        if (!(p.category in aff)) s += 1;
        return { p, s };
      })
      .sort((a, b) => b.s - a.s)
      .slice(0, 8)
      .map((x) => x.p);
  } else {
    const byCat = {};
    state.products.forEach((p) => { if (p.in_stock) { (byCat[p.category] = byCat[p.category] || []).push(p); } });
    const cats = CAT_ORDER.filter((c) => byCat[c]);
    let i = 0, guard = 0;
    while (picks.length < 8 && cats.length > 0 && guard < 300) {
      const c = cats[i % cats.length];
      if (byCat[c].length) picks.push(byCat[c].shift());
      else cats.splice(i % cats.length, 1);
      i++; guard++;
    }
  }

  const tasteCounts = {};
  wished.forEach((p) => { tasteCounts[label(p.category)] = (tasteCounts[label(p.category)] || 0) + 1; });
  (cart || []).forEach((i) => { tasteCounts[label(i.category)] = (tasteCounts[label(i.category)] || 0) + 1; });
  const topTaste = Object.entries(tasteCounts).sort((a, b) => b[1] - a[1]).slice(0, 4);

  const openProduct = openId ? state.products.find((p) => p.id === openId) : null;

  return (
    <div>
      {toast && (
      <div style={{ position: "fixed", top: 24, left: "50%", transform: "translateX(-50%)", background: "#EC4899", color: "#fff", padding: "10px 24px", borderRadius: 999, fontWeight: 600, fontSize: 14, boxShadow: "0 8px 24px rgba(236,72,153,0.35)", zIndex: 60, display: "flex", alignItems: "center", gap: 8 }}>
        <Icon name="heart" size={15} /> {toast}
      </div>
    )}
      <PageHeader icon="sparkle" title="For You" subtitle="Picked from what you touch, wishlist and bag — with the why attached." />
      {state.loading && <LoadingState label="Learning your taste..." />}
      {state.error && <ErrorState message={state.error} onRetry={load} />}
      {!state.loading && !state.error && (
        <div>
          <div className="card" style={{ padding: 22, marginBottom: 20, display: "flex", gap: 20, flexWrap: "wrap", alignItems: "center", justifyContent: "space-between" }}>
            <div style={{ flex: "1 1 340px" }}>
              <p style={{ fontWeight: 700, fontSize: 15, marginBottom: 8, display: "flex", alignItems: "center", gap: 8 }}><Icon name="user" size={15} style={{ color: "var(--pink)" }} /> Your taste, as I know it</p>
              {cold ? (
                <p style={{ fontSize: 13, color: "var(--text-soft)", lineHeight: 1.5 }}>I'm still getting to know you. Tap the heart on a few things you love, and this card — plus the picks below — reshapes around your taste.</p>
              ) : (
                <div>
                  <div style={{ display: "flex", gap: 8, flexWrap: "wrap", marginBottom: 8 }}>
                    {topTaste.map(([c, n]) => (
                      <span key={c} style={{ fontSize: 12, fontWeight: 600, padding: "5px 12px", borderRadius: 999, background: "var(--pink-soft)", color: "var(--pink)" }}>{n} × {c}</span>
                    ))}
                  </div>
                  <p style={{ fontSize: 12.5, color: "var(--text-soft)" }}>
                    {wished.length} wishlisted{cart && cart.length ? " · " + cart.length + " in bag" : ""}{avgWish ? " · usually around ₹" + avgWish : ""}
                  </p>
                  <p style={{ fontSize: 12, color: "var(--text-soft)", marginTop: 4 }}>I learn only from your hearts and bag adds on this device — nothing creepy.</p>
                </div>
              )}
              {resetMsg && <p style={{ fontSize: 12.5, color: "var(--pink)", fontWeight: 600, marginTop: 8 }}>{resetMsg}</p>}
            </div>
            <button onClick={resetTaste} disabled={resetting} style={{ padding: "9px 18px", borderRadius: 12, border: "1px solid var(--border)", background: "#fff", color: "var(--text-soft)", fontWeight: 600, fontSize: 12.5, cursor: "pointer", display: "flex", alignItems: "center", gap: 7 }}>
              <Icon name="refresh" size={13} /> {resetting ? "Clearing..." : "Reset my taste"}
            </button>
          </div>

          <p style={{ fontWeight: 700, fontSize: 14.5, marginBottom: 12 }}>{cold ? "Boutique favourites to get you started" : "Because of what you love"}</p>
          <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(230px, 1fr))", gap: 18 }}>
            {picks.map((p) => (
              <div key={p.id} className="card fade-up" style={{ padding: 18, position: "relative" }}>
                <img onClick={() => setOpenId(p.id)} src={API_CONFIG.baseUrl + p.image} alt={p.name} title="Click to see it up close" style={{ width: "100%", height: 165, objectFit: "cover", borderRadius: 14, marginBottom: 10, background: "var(--pink-soft)", cursor: "pointer" }} />
                <button onClick={(e) => { e.stopPropagation(); toggleFav(p); }} title="Save to wishlist" style={{ position: "absolute", top: 26, right: 26, width: 32, height: 32, borderRadius: "50%", border: wishlist.includes(p.id) ? "1px solid #FF1E3C" : "1px solid var(--border)", background: wishlist.includes(p.id) ? "#FFF0F2" : "#fff", display: "flex", alignItems: "center", justifyContent: "center", cursor: "pointer", color: wishlist.includes(p.id) ? "#FF1E2C" : "var(--text-soft)", boxShadow: wishlist.includes(p.id) ? "0 2px 10px rgba(255,30,60,0.35)" : "0 2px 8px rgba(0,0,0,0.08)", transform: wishlist.includes(p.id) ? "scale(1.08)" : "scale(1)", transition: "all 0.15s ease" }}>
                  <Icon name="heart" size={16} fill={wishlist.includes(p.id) ? "#FF1E2C" : "none"} />
                </button>
                <p style={{ fontSize: 11.5, fontWeight: 600, color: "var(--pink)", background: "var(--pink-soft)", padding: "6px 10px", borderRadius: 10, marginBottom: 8, lineHeight: 1.4 }}>
                  {cold ? "A boutique favourite — teach me your taste with a heart" : reasonFor(p)}
                </p>
                <p onClick={() => setOpenId(p.id)} style={{ fontWeight: 700, fontSize: 14, marginBottom: 4, cursor: "pointer" }}>{p.name}</p>
                <p style={{ fontWeight: 700, marginBottom: 10, fontSize: 13.5 }}>{"₹"}{p.price}</p>
                {p.in_stock ? (
                  <button className="btn btn-sm" onClick={() => addToCart(p)} style={{ width: "100%", display: "flex", alignItems: "center", justifyContent: "center", gap: 6 }}>
                    {addedId === p.id ? (<><Icon name="check" size={14} /> Added</>) : "Add to Bag"}
                  </button>
                ) : (
                  <p style={{ fontSize: 12.5, color: "var(--text-soft)", textAlign: "center" }}>Out of stock</p>
                )}
              </div>
            ))}
          </div>
        </div>
      )}
      {openProduct && (
        <ProductModal p={openProduct} onClose={() => setOpenId(null)} onAdd={addToCart} addedId={addedId} wishlisted={wishlist.includes(openProduct.id)} onWish={toggleFav} />
      )}
    </div>
  );
}
function ShopPage({ cart, setCart, wishlist, setWishlist }) {
  const [state, setState] = useState({ loading: true, error: null, products: [] });
  const [toast, setToast] = useState(null);
  const [addedId, setAddedId] = useState(null);
  const [query, setQuery] = useState("");
  const [cat, setCat] = useState("all");
  const [sort, setSort] = useState("featured");
  const [openId, setOpenId] = useState(null);

  const load = useCallback(() => {
    setState({ loading: true, error: null, products: [] });
    api.getProducts().then((res) => {
      if (res.ok) {
          setState({ loading: false, error: null, products: res.data.products });
          res.data.products.forEach((p) => logEvent("view", p.id, { context: "shop_grid" }));
        }
      else setState({ loading: false, error: res.message, products: [] });
    });
  }, []);

  useEffect(() => { load(); }, [load]);

  function toggleFav(p) {
    const has = wishlist.includes(p.id);
    const call = has ? api.favRemove(p.id) : api.favAdd(p.id);
    call.then((res) => {
      if (res.ok) {
        setWishlist(res.data.favorites);
        logEvent(has ? "wishlist_remove" : "wishlist_add", p.id);
      } else alert(res.message || "Couldn't update wishlist.");
    });
  }

  function addToCart(p, size = null) {
    api.cartAdd(p.id, 1, size).then((res) => {
      if (res.ok) {
        setCart(res.data.items.map((i) => ({ ...i.product, qty: i.qty })));
        setToast("Added to your bag" + (size ? " · Size " + size : ""));
        setAddedId(p.id);
        logEvent("cart_add", p.id);
        setTimeout(() => setToast(null), 3000);
        setTimeout(() => setAddedId(null), 2000);
      } else alert(res.message || "Couldn't add to bag. Try again.");
    });
  }

  let shown = state.products;
  if (cat !== "all") shown = shown.filter((p) => p.category === cat);
  if (query.trim()) {
    const q = query.trim().toLowerCase();
    shown = shown.filter((p) => (p.name + " " + p.description + " " + (CAT_LABELS[p.category] || p.category)).toLowerCase().includes(q));
  }
  if (sort === "low") shown = shown.slice().sort((a, b) => a.price - b.price);
  if (sort === "high") shown = shown.slice().sort((a, b) => b.price - a.price);
  if (sort === "name") shown = shown.slice().sort((a, b) => a.name.localeCompare(b.name));
  const openProduct = openId ? state.products.find((p) => p.id === openId) : null;

  return (
    <div>
      {toast && (
      <div style={{ position: "fixed", top: 24, left: "50%", transform: "translateX(-50%)", background: "#EC4899", color: "#fff", padding: "10px 24px", borderRadius: 999, fontWeight: 600, fontSize: 14, boxShadow: "0 8px 24px rgba(236,72,153,0.35)", zIndex: 60, display: "flex", alignItems: "center", gap: 8 }}>
        <Icon name="heart" size={15} /> {toast}
      </div>
    )}
      <PageHeader icon="bag" title="Shop" subtitle="Search, filter and zoom into the full Bubblegum Atelier collection." />
      {state.loading && <LoadingState label="Styling your dashboard..." />}
      {state.error && <ErrorState message={state.error} onRetry={load} />}
      {!state.loading && !state.error && (
        <div>
          <div style={{ display: "flex", gap: 10, marginBottom: 12, flexWrap: "wrap" }}>
            <div style={{ flex: "1 1 260px", display: "flex", alignItems: "center", gap: 8, background: "#fff", border: "1px solid var(--border)", borderRadius: 999, padding: "9px 16px" }}>
              <Icon name="search" size={15} style={{ color: "var(--text-soft)" }} />
              <input value={query} onChange={(e) => setQuery(e.target.value)} placeholder="Search heels, tote, lip gloss..." style={{ border: "none", outline: "none", fontSize: 13.5, width: "100%", background: "transparent", color: "inherit" }} />
              {query && <button onClick={() => setQuery("")} style={{ border: "none", background: "transparent", cursor: "pointer", color: "var(--text-soft)", display: "flex", padding: 0 }}><Icon name="x" size={13} /></button>}
            </div>
            <select value={sort} onChange={(e) => setSort(e.target.value)} style={{ border: "1px solid var(--border)", borderRadius: 999, padding: "9px 14px", fontSize: 13, background: "#fff", color: "inherit", cursor: "pointer", outline: "none" }}>
              <option value="featured">Sort: Featured</option>
              <option value="low">Price: Low to High</option>
              <option value="high">Price: High to Low</option>
              <option value="name">Name: A to Z</option>
            </select>
          </div>
          <div style={{ display: "flex", gap: 8, marginBottom: 16, flexWrap: "wrap", alignItems: "center" }}>
            {["all"].concat(CAT_ORDER.filter((c) => state.products.some((p) => p.category === c))).map((c) => (
              <button key={c} onClick={() => setCat(c)} style={{ padding: "7px 15px", borderRadius: 999, fontSize: 12.5, fontWeight: 600, cursor: "pointer", border: cat === c ? "1px solid var(--pink)" : "1px solid var(--border)", background: cat === c ? "var(--pink)" : "#fff", color: cat === c ? "#fff" : "var(--text-soft)", transition: "all 0.15s ease" }}>
                {c === "all" ? "All Treats" : CAT_LABELS[c]}
              </button>
            ))}
            <span style={{ marginLeft: "auto", fontSize: 12, color: "var(--text-soft)" }}>{shown.length} of {state.products.length} treats</span>
          </div>
          {shown.length === 0 && (
            <div className="card" style={{ padding: 34, textAlign: "center", color: "var(--text-soft)", fontSize: 13.5 }}>
              Nothing matches "{query}" yet — try "bag", "heels" or "pink".
            </div>
          )}
          <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(220px, 1fr))", gap: 18 }}>
            {shown.map((p) => (
              <div key={p.id} className="card fade-up" style={{ padding: 18, position: "relative" }}>
                <img onClick={() => setOpenId(p.id)} src={API_CONFIG.baseUrl + p.image} alt={p.name} title="Click to see it up close" style={{ width: "100%", height: 170, objectFit: "cover", borderRadius: 14, marginBottom: 12, background: "var(--pink-soft)", cursor: "pointer" }} />
                <button onClick={(e) => { e.stopPropagation(); toggleFav(p); }} title="Save to wishlist" style={{ position: "absolute", top: 26, right: 26, width: 32, height: 32, borderRadius: "50%", border: wishlist.includes(p.id) ? "1px solid #FF1E3C" : "1px solid var(--border)", background: wishlist.includes(p.id) ? "#FFF0F2" : "#fff", display: "flex", alignItems: "center", justifyContent: "center", cursor: "pointer", color: wishlist.includes(p.id) ? "#FF1E2C" : "var(--text-soft)", boxShadow: wishlist.includes(p.id) ? "0 2px 10px rgba(255,30,60,0.35)" : "0 2px 8px rgba(0,0,0,0.08)", transform: wishlist.includes(p.id) ? "scale(1.08)" : "scale(1)", transition: "all 0.15s ease" }}>
                  <Icon name="heart" size={16} fill={wishlist.includes(p.id) ? "#FF1E2C" : "none"} />
                </button>
                <p onClick={() => setOpenId(p.id)} style={{ fontWeight: 700, fontSize: 14.5, marginBottom: 4, cursor: "pointer" }}>{p.name}</p>
                <p style={{ fontSize: 12.5, color: "var(--text-soft)", marginBottom: 10, lineHeight: 1.45 }}>{p.description}</p>
                <p style={{ fontWeight: 700, marginBottom: 10 }}>{"₹"}{p.price}</p>
                {p.in_stock ? (
                  <button className="btn btn-sm" onClick={() => addToCart(p)} style={{ width: "100%", display: "flex", alignItems: "center", justifyContent: "center", gap: 6 }}>
                    {addedId === p.id ? (<><Icon name="check" size={14} /> Added</>) : "Add to Bag"}
                  </button>
                ) : (
                  <p style={{ fontSize: 12.5, color: "var(--text-soft)", textAlign: "center" }}>Out of stock</p>
                )}
              </div>
            ))}
          </div>
        </div>
      )}
      {openProduct && (
        <ProductModal p={openProduct} onClose={() => setOpenId(null)} onAdd={addToCart} addedId={addedId} wishlisted={wishlist.includes(openProduct.id)} onWish={toggleFav} />
      )}
    </div>
  );
}
function CartPage({ cart, setCart }) {
  const [orderMsg, setOrderMsg] = useState(null);
  const [checkingOut, setCheckingOut] = useState(false);

  const adapt = (items) => items.map((i) => ({ ...i.product, qty: i.qty }));

  const loadCart = useCallback(() => {
    api.cartGet().then((res) => {
      if (res.ok) setCart(adapt(res.data.items));
    });
  }, [setCart]);
  useEffect(() => { loadCart(); }, [loadCart]);

  function changeQty(item, qty) {
    api.cartUpdate(item.id, qty).then((res) => {
      if (res.ok) setCart(adapt(res.data.items));
      else alert(res.message || "Couldn't update quantity.");
    });
  }

  function removeItem(item) {
    api.cartRemove(item.id).then((res) => {
      if (res.ok) setCart(adapt(res.data.items));
      else alert(res.message || "Couldn't remove item.");
    });
  }

  function checkout() {
    setCheckingOut(true);
    setOrderMsg(null);
    api.checkoutIntent().then((res) => {
      setCheckingOut(false);
      if (res.ok) {
        setCart([]);
        logEvent("checkout_intent", null, { context: "bag" });
        setOrderMsg("Order intent recorded: " + res.data.order_intent_id + " - " + res.data.item_count + " item(s), total \u20B9" + res.data.total + ". (Demo storefront, no payment taken.)");
      } else {
        alert(res.message || "Checkout failed. Please try again.");
      }
    });
  }

  const total = cart.reduce((sum, i) => sum + i.price * i.qty, 0);
  const qtyBtn = { width: 26, height: 26, borderRadius: 8, border: "1px solid var(--border)", background: "#fff", cursor: "pointer", fontWeight: 700 };

  return (
    <div>
      <PageHeader icon="sparkle" title="My Bag" subtitle="Review your picks before checkout." />
      {orderMsg && (
        <div className="card fade-up" style={{ padding: 18, maxWidth: 560, marginBottom: 16, background: "#ECFDF5", borderColor: "#A7F3D0" }}>
          <p style={{ fontWeight: 600, fontSize: 14, color: "#047857" }}>{orderMsg}</p>
        </div>
      )}
      <div className="card fade-up" style={{ padding: 26, maxWidth: 560 }}>
        {cart.length === 0 ? (
          <div style={{ textAlign: "center", padding: "10px 0 6px" }}>
              <img src={API_CONFIG.baseUrl + "/static/graphics/empty-bag.png"} alt="" style={{ width: 170, borderRadius: 16, marginBottom: 12 }} />
              <p style={{ fontWeight: 700, marginBottom: 6 }}>Your bag is empty</p>
              <p style={{ fontSize: 13.5, color: "var(--text-soft)" }}>Go find something cute in the Shop.</p>
            </div>
        ) : (
          <>
            {cart.map((item) => (
              <div key={item.id} style={{ display: "flex", justifyContent: "space-between", alignItems: "center", padding: "12px 0", borderBottom: "1px solid var(--border)" }}>
                <div>
                  <p style={{ fontWeight: 600, fontSize: 14 }}>{item.name}</p>
                  <div style={{ display: "flex", alignItems: "center", gap: 8, marginTop: 6 }}>
                    <button onClick={() => changeQty(item, item.qty - 1)} style={qtyBtn}>-</button>
                    <span style={{ fontWeight: 700, minWidth: 18, textAlign: "center" }}>{item.qty}</span>
                    <button onClick={() => changeQty(item, item.qty + 1)} style={qtyBtn}>+</button>
                  </div>
                </div>
                <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
                  <span style={{ fontWeight: 700 }}>{"\u20B9"}{item.price * item.qty}</span>
                  <button onClick={() => removeItem(item)} style={{ border: "none", background: "none", color: "#EF4444", cursor: "pointer" }}>
                    <Icon name="x" size={15} />
                  </button>
                </div>
              </div>
            ))}
            <p style={{ fontSize: 18, fontWeight: 700, marginTop: 18 }}>Total: {"\u20B9"}{total}</p>
            <button className="btn" style={{ marginTop: 14 }} onClick={checkout} disabled={checkingOut}>
              {checkingOut ? "Recording..." : "Checkout"}
            </button>
          </>
        )}
      </div>
    </div>
  );
}


function WishlistPage({ cart, setCart, wishlist, setWishlist }) {
  const [state, setState] = useState({ loading: true, error: null, products: [] });
  const [movedId, setMovedId] = useState(null);
  const load = useCallback(() => {
    setState({ loading: true, error: null, products: [] });
    api.favGet().then((res) => {
      if (res.ok) {
        setState({ loading: false, error: null, products: res.data.products });
        setWishlist(res.data.products.map((p) => p.id));
      } else setState({ loading: false, error: res.message, products: [] });
    });
  }, [setWishlist]);
  useEffect(() => { load(); }, [load]);

  function moveToBag(p) {
    api.cartAdd(p.id, 1).then((res) => {
      if (!res.ok) { alert(res.message || "Couldn't move to bag."); return; }
      setCart(res.data.items.map((i) => ({ ...i.product, qty: i.qty })));
      logEvent("cart_add", p.id, { context: "wishlist" });
      api.favRemove(p.id).then((fav) => {
        if (fav.ok) setWishlist(fav.data.favorites);
        load();
        setMovedId(p.id);
        setTimeout(() => setMovedId(null), 1500);
      });
    });
  }

  function removeFav(p) {
    api.favRemove(p.id).then((res) => {
      if (res.ok) { setWishlist(res.data.favorites); logEvent("wishlist_remove", p.id); load(); }
    });
  }

  return (
    <div>
      <PageHeader icon="star" title="Wishlist" subtitle="Pieces you set aside - they wait right here for you." />
      {state.loading && <LoadingState label="Gathering your favorites..." />}
      {state.error && <ErrorState message={state.error} onRetry={load} />}
      {!state.loading && !state.error && state.products.length === 0 && (
        <div className="card fade-up" style={{ padding: 34, maxWidth: 480, textAlign: "center" }}>
          <img src={API_CONFIG.baseUrl + "/static/graphics/empty-wishlist.png"} alt="" style={{ width: 180, borderRadius: 16, marginBottom: 14 }} />
          <p style={{ fontWeight: 700, marginBottom: 6 }}>Nothing saved yet</p>
          <p style={{ fontSize: 13.5, color: "var(--text-soft)" }}>Tap the little heart on anything you love in the Shop, and it waits for you here.</p>
        </div>
      )}
      {!state.loading && !state.error && state.products.length > 0 && (
        <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(220px, 1fr))", gap: 18 }}>
          {state.products.map((p) => (
            <div key={p.id} className="card fade-up" style={{ padding: 18 }}>
              <img src={API_CONFIG.baseUrl + p.image} alt={p.name} style={{ width: "100%", height: 170, objectFit: "cover", borderRadius: 14, marginBottom: 12, background: "var(--pink-soft)" }} />
              <p style={{ fontWeight: 700, fontSize: 14.5, marginBottom: 4 }}>{p.name}</p>
              <p style={{ fontWeight: 700, marginBottom: 10 }}>{"₹"}{p.price}</p>
              <button className="btn btn-sm" onClick={() => moveToBag(p)} style={{ width: "100%", marginBottom: 8 }}>{movedId === p.id ? "Moved to Bag!" : "Move to Bag"}</button>
              <button onClick={() => removeFav(p)} style={{ width: "100%", padding: "7px 0", borderRadius: 10, border: "1px solid var(--border)", background: "#fff", color: "var(--text-soft)", fontSize: 12.5, cursor: "pointer" }}>Remove</button>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

