function SettingsPage() {
  const maskedKey = API_CONFIG.apiKey.slice(0, 4) + "*******" + API_CONFIG.apiKey.slice(-3);
  return (
    <div>
      <PageHeader icon="gear" title="Settings" subtitle="Studio configuration - more preferences coming soon." />
      <div className="card fade-up" style={{ padding: 26, maxWidth: 560 }}>
        <p style={{ fontSize: 12.5, fontWeight: 700, color: "var(--text-soft)", marginBottom: 14 }}>CONNECTED API</p>
        <div style={{ display: "flex", justifyContent: "space-between", padding: "12px 0", borderBottom: "1px solid var(--border)" }}>
          <span style={{ fontSize: 13.5, color: "var(--text-soft)" }}>Base URL</span>
          <span style={{ fontSize: 13.5, fontWeight: 600 }}>{API_CONFIG.baseUrl}</span>
        </div>
        <div style={{ display: "flex", justifyContent: "space-between", padding: "12px 0" }}>
